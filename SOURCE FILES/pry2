#include <xc.h>
#include <stdio.h>
#include "config.h"
#include "adc.h"
#include "i2c.h"
#include "ssd1306_oled.h"
#include "sensores.h"
#include "bme280_lib.h"

char txt_temp[20];
char txt_luz[20];
char txt_hum[20];

float temp;
float humedad;

unsigned int  temp_x10;
unsigned int  entero;
unsigned char decimal;
unsigned int  luz_pct;
unsigned char bme_ok;
unsigned char ventilador_duty = 0;

void main(void)
{
    OSCCON = 0x72;

    TRISAbits.TRISA0 = 1;
    TRISAbits.TRISA1 = 1;
    
    // Salida para el relay
    RELE_TRIS = 0;          // RB3 como salida
    RELE_PIN  = OFF;      
    
    // Salida de buzzer
    BUZZER_TRIS = 0;
    BUZZER_PIN  = OFF;  
        
    // Salida de LED's
    LED_TRIS = 0;
    LED_PIN  = OFF;  
    
    LED2_TRIS = 0;
    LED2_PIN  = OFF;  
    
    // Salida ventilador
    VEN_TRIS = 0;
    VEN_PIN  = OFF; 
       
    ADC_Init(AN0_AN1_ANALOG);
    I2C_Init_Master(I2C_100KHZ);
    OLED_Init();
    PWM_Init();

  
    bme_ok = BME280_Init();

    while(1)
    {
         // LDR
       
        luz_pct = LDR_ObtenerPorcentaje();
        
        // --- Control Led
        
        if(luz_pct < LUZ_UMBRAL)
        {
            LED_PIN = ON;
            LED2_PIN = ON;
        }
        else
        {
            LED_PIN = OFF; 
            LED2_PIN = OFF;
        }


        
        // LM35 
        
        temp = LM35_ObtenerTemp();

        if(temp < 0.0f) {

            temp = 0.0f;
        }

        temp_x10 = (unsigned int)(temp * 10.0f + 0.5f);
        entero = temp_x10 / 10;
        decimal = (unsigned char)(temp_x10 % 10);

        // --- Control del rele con histeresis ---
        if(temp > TEMP_LOW) {

            RELE_PIN = ON;     // Temperatura baja: enciende calentador
        }
        else if(temp < TEMP_HIGH) {

            RELE_PIN = OFF;    // Temperatura alta: apaga calentador
        }
        
        // BME 280 
        
        if(bme_ok) {

            humedad = leer_humedad();
        }
        else{

            humedad = -1.0f;
        }
        
        // MQ135 
                
        if(MQ135_GasDetectado())
        {
            // Gas detectado: habilita y fuerza velocidad máxima
            VEN_PIN = ON ;
            PWM_SetDuty(100);
            BUZZER_PIN = ON;
        }
        else if(humedad < 0.0f)
        {
            // Error sensor: apaga completamente
            VEN_PIN = OFF;
            PWM_SetDuty(0);
            BUZZER_PIN = OFF;
        }
         else if(humedad < HUM_APAGADO)
        {
            VEN_PIN = OFF;
            ventilador_duty = 0;
            PWM_SetDuty(0);
        }
        else if(humedad >= HUM_BAJA)
        {
            // Humedad media: habilita a media velocidad
            VEN_PIN = ON;
            ventilador_duty = 30;
            PWM_SetDuty(30);
            BUZZER_PIN = OFF;
        }
        else if(humedad >= HUM_ALTA)
        {
            VEN_PIN = ON;
            ventilador_duty = 100;
            PWM_SetDuty(100);
            BUZZER_PIN = OFF;
        }
      

        OLED_ClearDisplay();
        
        OLED_SetFont(FONT_1);
        OLED_Write_Text(0, 0, "LM35");
        OLED_Write_Text(48, 0, "LDR");
        OLED_Write_Text(92, 0, "MQ135");
        OLED_Write_Text(0, 10, "Temp:");
        OLED_Write_Text(48, 10, "Luz:");
        OLED_Write_Text(92, 10, "Gas:");
       
        

        OLED_SetFont(FONT_1);
        sprintf(txt_temp, "%u.%u C", entero, decimal);
        OLED_Write_Text(0, 24, txt_temp);

        sprintf(txt_luz, "%u%%", luz_pct);
        OLED_Write_Text(48, 24, txt_luz);
        
        if(MQ135_GasDetectado()){

            OLED_Write_Text(92, 24, "ALTO");
        }
        else{

            OLED_Write_Text(92, 24, "OK");
        }

        if(humedad < 0.0f){

            OLED_Write_Text(32, 42, "ERR");
        }
        else{
            
            sprintf(txt_hum, "%.1f%%", humedad);
            OLED_Write_Text(32, 42, txt_hum);
        }

        OLED_Update();
        __delay_ms(200);
    }
}

