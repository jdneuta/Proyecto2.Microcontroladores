#include <xc.h>
#include <stdio.h>
#include "config.h"
#include "adc.h"
#include "i2c.h"
#include "ssd1306_oled.h"

char txt_temp[20];
float temp;
unsigned int temp_x10;
unsigned int entero;
unsigned char decimal;

unsigned int luz_pct;
char txt_luz[20];

void main(void)
{
    OSC_Init();

    TRISAbits.TRISA0 = 1;
    TRISAbits.TRISA1 = 1;
    ADC_Init(AN0_AN1_ANALOG);

    I2C_Init_Master(I2C_100KHZ);
    OLED_Init();

    while(1)
    {
        temp = LM35_ObtenerTemp();

        if(temp < 0.0f)
        {
            temp = 0.0f;
        }

        temp_x10 = (unsigned int)(temp * 10.0f + 0.5f);
        entero = temp_x10 / 10;
        decimal = (unsigned char)(temp_x10 % 10);
        
        luz_pct = LDR_ObtenerPorcentaje();

        OLED_ClearDisplay();

        OLED_SetFont(FONT_1);
        OLED_Write_Text(0, 0, "LM35");
        OLED_Write_Text(70, 0, "LDR");
        OLED_Write_Text(0, 10, "Temp:");
        OLED_Write_Text(70, 10, "Luz:");

        OLED_SetFont(FONT_2);
        sprintf(txt_temp, "%u.%u C", entero, decimal);
        OLED_Write_Text(0, 24, txt_temp);

        sprintf(txt_luz, "%u%%", luz_pct);
        OLED_Write_Text(70, 24, txt_luz);


        OLED_Update();
        __delay_ms(300);
    }
}
